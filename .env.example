# Names only. Store local secrets in ignored .dev.vars, production secrets via Wrangler.
DISCORD_CLIENT_ID=your_public_application_id
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
# Build-time deployment identifiers (Workers Builds variables in production). Not secrets.
# For a local `npm run build`, export them in your shell; any values in the right format work.
D1_DATABASE_ID=your_database_id
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_PUBLIC_KEY=your_discord_application_public_key
# Comma-separated: canonical owner identity first, then any linked owner logins.
OWNER_DISCORD_IDS=your_discord_user_id
# Worker secret that signs the post-deploy sync check. Also a GitHub/Workers Builds secret for the checker.
DEPLOY_CHECK_SECRET=
# Optional emergency import stop, configured as a Worker variable/secret.
SYNC_PAUSED=false
# Local development login remains disabled unless explicitly enabled for local testing.
LOCAL_PREVIEW_LOGIN=

# Optional read-only service bridge; separate from Discord OAuth/session secrets.
DISCORD_ROLE_SYNC_SECRET=
