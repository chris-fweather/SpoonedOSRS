# Keep the real .env private. Never paste tokens into chat or Git.
DISCORD_BOT_TOKEN=
# Must match the Worker secret DISCORD_ROLE_SYNC_SECRET (32+ random characters).
DISCORD_ROLE_SYNC_SECRET=
SPOONED_ORIGIN=https://spoonedosrs.com
DISCORD_GUILD_ID=your_server_id
# Real server role IDs, not names. Keys allowed: helper, moderator, admin, owner, supporter.
DISCORD_ROLE_MAP={}
# Defaults to a dry run. Enable only after checking roles and hierarchy.
DISCORD_ROLE_SYNC_APPLY=false
